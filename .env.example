# Copy to .env (`npm run dev` does this for you on first run).
# Never commit the .env file.

# --- Server ---
NODE_ENV=development
PORT=4000
# info | debug | warn | error
LOG_LEVEL=info
# Public address of the web app. Used for CORS and for links in emails.
APP_URL=http://localhost:5173
# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false

# --- Database (MySQL 8) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=budget_book
# Creates the database and applies pending migrations when the API starts.
RUN_MIGRATIONS_ON_START=true
# Adds demo accounts with sample data. Never enable on a public server.
SEED_DEMO_DATA=true

# --- Authentication ---
# At least 32 characters. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

# --- Email (optional) ---
# Leave SMTP_HOST empty in development: emails are saved as files in the .dev-mail folder.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Budget Book <no-reply@example.com>

# --- Web app ---
# Public address used for canonical links, sitemap and social previews.
VITE_SITE_URL=http://localhost:5173
# Where the Vite dev server forwards /api requests.
VITE_DEV_API_PROXY=http://127.0.0.1:4000
